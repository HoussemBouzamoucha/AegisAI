# ---------- Build Stage ----------
FROM rust:1.93 AS builder

WORKDIR /app

# Copy Cargo.toml and Cargo.lock
COPY Antivirus_Engine/cargo.toml Antivirus_Engine/Cargo.lock ./

# Pre-build dependencies (cache layer)
RUN cargo build --release || true

# Copy Rust source code
COPY Antivirus_Engine/src ./src

# Build release binary
RUN cargo build --release

# ---------- Runtime Stage ----------
FROM debian:bullseye-slim

# Optional: create a user for security
RUN useradd -m rustuser
USER rustuser

WORKDIR /app

# Copy compiled binary from build stage
COPY --from=builder /app/target/release/aegisai_rust_binary .

# Default command
CMD ["./aegisai_rust_binary"]
